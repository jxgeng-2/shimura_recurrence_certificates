            [-155, 4, 2, [-1, -1], [1/2, -21, 73/2, -51/2], 3],
            [-155, 4, 3, [-1, -1], [1/2, -13/2, 23/2, -8], 19],
            [-155, 4, 4, [-1, -1], [1/2, -129/2, 35/2, 3], 3],
            [-163, 1, 1, [-1, -1], [1/2, -7/2, -3/2, 0], 1],
